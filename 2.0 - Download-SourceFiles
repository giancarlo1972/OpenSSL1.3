# 1 - Download OpenSSL 3.6.1 (latest stable) from FireDaemon
$OpenSSLUrl = "https://download.firedaemon.com/FireDaemon-OpenSSL/FireDaemon-OpenSSL-x64-3.6.1.exe"
$OutputPath = "C:\Intune\OpenSSL\Source\FireDaemon-OpenSSL-x64-3.6.1.exe"

Invoke-WebRequest -Uri $OpenSSLUrl -OutFile $OutputPath

# Verify the download
if (Test-Path $OutputPath) {
    Write-Host "OpenSSL installer downloaded successfully" -ForegroundColor Green
    Get-Item $OutputPath | Select-Object Name, Length
}




