# Install-OpenSSL.ps1
# Update filename to match what you downloaded
$InstallerName = "FireDaemon-OpenSSL-x64-3.6.1.exe"  
# Or use: "Win64OpenSSL-3_4_0.exe" if using Shining Light

$InstallerPath = Join-Path $PSScriptRoot $InstallerName
$LogPath = "$env:ProgramData\Intune\Logs\OpenSSL-Install.log"

# Create log directory
$LogDir = Split-Path $LogPath
if (!(Test-Path $LogDir)) {
    New-Item -ItemType Directory -Path $LogDir -Force
}

# Verify installer exists
if (!(Test-Path $InstallerPath)) {
    Write-Error "Installer not found at: $InstallerPath"
    exit 1603
}

# Silent installation arguments for FireDaemon OpenSSL
if ($InstallerName -like "*FireDaemon*") {
    $InstallArgs = @(
        "/exenoui"
        "/exelog"
        "`"$LogPath`""
        "/qn"
        "/norestart"
        "REBOOT=ReallySuppress"
    )
    $Process = Start-Process -FilePath $InstallerPath -ArgumentList $InstallArgs -Wait -NoNewWindow -PassThru
}
# Silent installation for Shining Light OpenSSL
elseif ($InstallerName -like "*Win64OpenSSL*") {
    $InstallArgs = @(
        "/VERYSILENT"
        "/SUPPRESSMSGBOXES"
        "/NORESTART"
        "/LOG=`"$LogPath`""
    )
    $Process = Start-Process -FilePath $InstallerPath -ArgumentList $InstallArgs -Wait -NoNewWindow -PassThru
}

# Check installation result
if ($Process.ExitCode -eq 0) {
    Write-Output "OpenSSL installation completed successfully"
    
    # Verify installation - check multiple possible paths
    $OpenSSLPaths = @(
        "${env:ProgramFiles}\FireDaemon OpenSSL 3\bin\openssl.exe",
        "${env:ProgramFiles}\OpenSSL-Win64\bin\openssl.exe",
        "${env:ProgramFiles}\OpenSSL\bin\openssl.exe"
    )
    
    foreach ($Path in $OpenSSLPaths) {
        if (Test-Path $Path) {
            $Version = & $Path version
            Write-Output "Verified: $Version at $Path"
            exit 0
        }
    }
    
    Write-Warning "Installation succeeded but OpenSSL.exe not found in expected locations"
    exit 0
} else {
    Write-Error "Installation failed with exit code: $($Process.ExitCode)"
    exit $Process.ExitCode
}
